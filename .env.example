POSTGRES_DB=custombuild
APP_ENV=development
PRODUCTION_FOUR_EYES_REQUIRED=false
COMPOSE_PROJECT_NAME=custombuild-prod
# Local builds deliberately identify themselves as uncommitted. CI replaces
# these values with the reviewed tag, full commit SHA, commit timestamp,
# canonical source URL, exact build/workflow source manifest and SHA-256 values
# for uv.lock and pnpm-lock.yaml.
APP_VERSION=0.1.0-local
VCS_REF=uncommitted
BUILD_DATE=unknown
SOURCE_URL=unknown
SOURCE_MANIFEST_SHA256=unknown
DEPENDENCY_LOCK_SHA256=unknown
FRONTEND_LOCK_SHA256=unknown
WEB_BIND_PORT=3000
API_BIND_PORT=8000
S3_BIND_PORT=9000
POSTGRES_BOOTSTRAP_USER=custombuild_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=change-me-bootstrap
MIGRATOR_DATABASE_USER=custombuild_migrator
MIGRATOR_DATABASE_PASSWORD=change-me-migrator
API_DATABASE_PASSWORD=change-me-api
WORKER_DATABASE_PASSWORD=change-me-worker
CAPACITY_ATTESTOR_DATABASE_USER=custombuild_storage_attestor
CAPACITY_ATTESTOR_DATABASE_PASSWORD=change-me-capacity-attestor
DATABASE_URL=postgresql+psycopg://custombuild_api:change-me-api@postgres:5432/custombuild
WORKER_DATABASE_URL=postgresql+psycopg://custombuild_worker:change-me-worker@postgres:5432/custombuild
MIGRATION_DATABASE_URL=postgresql+psycopg://custombuild_migrator:change-me-migrator@postgres:5432/custombuild
CAPACITY_ATTESTOR_DATABASE_URL=postgresql+psycopg://custombuild_storage_attestor:change-me-capacity-attestor@postgres:5432/custombuild
DATABASE_STATEMENT_TIMEOUT_SECONDS=60
DATABASE_LOCK_TIMEOUT_SECONDS=10
# Use a strong URL-safe value because Compose embeds it in redis:// URLs.
REDIS_PASSWORD=change-me-redis
# Compose derives the API/worker URL from REDIS_PASSWORD. Keep this URL in sync
# only when running Python services directly outside Compose.
REDIS_URL=redis://:change-me-redis@redis:6379/0
READINESS_TIMEOUT_SECONDS=2
RATE_LIMIT_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_BODY_IDLE_TIMEOUT_SECONDS=5
REQUEST_BODY_TOTAL_TIMEOUT_SECONDS=30
TRUSTED_PROXY_CIDRS=
S3_ENDPOINT=http://object-storage:8333
S3_BACKUP_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=custombuild
S3_SECRET_KEY=change-me-object-storage
S3_BUCKET=custombuild-artifacts
# External production only: the volume must already exist and expose an exact
# filesystem size through statvfs. The canonical operator-config values must
# match every expected value below byte-for-byte.
OBJECT_STORAGE_VOLUME_NAME=custombuild-object-storage-unconfigured
STORAGE_CAPACITY_OPERATOR_CONFIG_PATH=./deployment/storage-capacity-operator.json
STORAGE_CAPACITY_OPERATOR_CONFIG_SHA256=unverified
STORAGE_CAPACITY_VOLUME_IDENTITY=custombuild-object-storage-unconfigured
STORAGE_CAPACITY_PROVISIONED_BYTES=274877906944
STORAGE_CAPACITY_METADATA_OVERHEAD_BYTES=1073741824
STORAGE_CAPACITY_EMERGENCY_RESERVE_BYTES=4294967296
STORAGE_CAPACITY_HEADROOM_BYTES=5368709120
STORAGE_CAPACITY_BYTE_LIMIT=269509197824
STORAGE_CAPACITY_OBJECT_LIMIT=1000000
STORAGE_CAPACITY_DEPLOY_DESCRIPTOR_SHA256=unverified
STORAGE_CAPACITY_MAX_AGE_SECONDS=600
DEPLOY_DESCRIPTOR_PATH=./deployment/deploy-descriptor.json
STORAGE_CAPACITY_EVIDENCE_DIRECTORY=./deployment/storage-capacity-evidence
AUTH_MODE=development
OIDC_ISSUER=
OIDC_AUDIENCE=custombuild-api
CORS_ORIGINS=http://localhost:3000
ARTIFACT_SIGNING_SECRET=change-me-signing-secret-at-least-32-bytes
ARTIFACT_URL_TTL_SECONDS=300
ARTIFACT_STREAM_TIMEOUT_SECONDS=120
# Public web runtime configuration. These values are read when the container
# starts/serves requests, never baked into the image. The demo token is an
# intentionally public local credential and must be empty in production.
CUSTOMBUILD_WEB_API_URL=http://localhost:8000
CUSTOMBUILD_WEB_DEMO_TOKEN=demo-nordic-owner
# Production browser authentication (public PKCE client, no client secret):
CUSTOMBUILD_WEB_OIDC_ISSUER=
CUSTOMBUILD_WEB_OIDC_CLIENT_ID=
CUSTOMBUILD_WEB_OIDC_REDIRECT_URI=
