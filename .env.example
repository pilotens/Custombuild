POSTGRES_DB=custombuild
APP_ENV=development
PRODUCTION_FOUR_EYES_REQUIRED=false
COMPOSE_PROJECT_NAME=custombuild-prod
# Local builds deliberately identify themselves as uncommitted. CI replaces
# these values with the reviewed tag, full commit SHA, commit timestamp,
# canonical source URL, exact build/workflow source manifest and SHA-256 values
# for uv.lock and pnpm-lock.yaml.
APP_VERSION=0.1.0-local
VCS_REF=uncommitted
BUILD_DATE=unknown
SOURCE_URL=unknown
SOURCE_MANIFEST_SHA256=unknown
DEPENDENCY_LOCK_SHA256=unknown
FRONTEND_LOCK_SHA256=unknown
WEB_BIND_PORT=3000
API_BIND_PORT=8000
S3_BIND_PORT=9000
POSTGRES_BOOTSTRAP_USER=custombuild_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=change-me-bootstrap
MIGRATOR_DATABASE_USER=custombuild_migrator
MIGRATOR_DATABASE_PASSWORD=change-me-migrator
API_DATABASE_PASSWORD=change-me-api
WORKER_DATABASE_PASSWORD=change-me-worker
DATABASE_URL=postgresql+psycopg://custombuild_api:change-me-api@postgres:5432/custombuild
WORKER_DATABASE_URL=postgresql+psycopg://custombuild_worker:change-me-worker@postgres:5432/custombuild
MIGRATION_DATABASE_URL=postgresql+psycopg://custombuild_migrator:change-me-migrator@postgres:5432/custombuild
# Use a strong URL-safe value because Compose embeds it in redis:// URLs.
REDIS_PASSWORD=change-me-redis
# Compose derives the API/worker URL from REDIS_PASSWORD. Keep this URL in sync
# only when running Python services directly outside Compose.
REDIS_URL=redis://:change-me-redis@redis:6379/0
READINESS_TIMEOUT_SECONDS=2
RATE_LIMIT_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXY_CIDRS=
S3_ENDPOINT=http://object-storage:8333
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=custombuild
S3_SECRET_KEY=change-me-object-storage
S3_BUCKET=custombuild-artifacts
AUTH_MODE=development
OIDC_ISSUER=
OIDC_AUDIENCE=custombuild-api
CORS_ORIGINS=http://localhost:3000
ARTIFACT_SIGNING_SECRET=change-me-signing-secret-at-least-32-bytes
ARTIFACT_URL_TTL_SECONDS=300
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_TOKEN=demo-nordic-owner
# Production browser authentication (public PKCE client, no client secret):
NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_REDIRECT_URI=
